{
    "compilerOptions": {
        "target": "es2017",
        "module": "es2020",
        "moduleResolution": "node",
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["src/", "__tests__/", "__mocks__/", "lib/types/"]
}
