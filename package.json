{
  "name": "@reactnativelabs/wifi-networking",
  "version": "0.1.0",
  "description": "A react-native implementation for viewing and connecting to Wifi networks on Android and iOS devices.",
  "keywords": [
    "react",
    "react-native",
    "android",
    "ios",
    "wifi",
    "connect"
  ],
  "homepage": "https://github.com/jamenamcinteer/react-native-wifi-networking#readme",
  "bugs": {
    "url": "https://github.com/jamenamcinteer/react-native-wifi-networking/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamenamcinteer/react-native-wifi-networking.git"
  },
  "license": "MIT",
  "author": "Jamena McInteer",
  "type": "commonjs",
  "main": "src/index.js",
  "types": "lib/types/index.d.ts",
  "directories": {
    "example": "example",
    "lib": "lib"
  },
  "files": [
    "app.plugin.js",
    "/android/src/",
